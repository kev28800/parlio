{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "functions": { "api/index.ts": { "maxDuration": 60 } },
  "env": {
    "PARLIO_AI_GLOBAL_DAILY_LIMIT": "0",
    "NODEJS_HELPERS": "0",
    "COOKIE_SECURE": "true",
    "REQUIRE_REMOTE_DATABASE": "true",
    "TRUST_PROXY_HOPS": "1"
  },
  "build": { "env": { "NODEJS_HELPERS": "0" } },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
